CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef
CONTROL_PLANE_API_KEY=sk-your-openai-runtime-api-key
YAZIO_USERNAME=your-yazio-email@example.com
YAZIO_PASSWORD=your-yazio-password

# Optional: override the API endpoint or OAuth client pair when YAZIO changes it.
# YAZIO_API_BASE_URL=https://yzapi.yazio.com/v15
# YAZIO_CLIENT_ID=...
# YAZIO_CLIENT_SECRET=...
# Alternatively, provide a current token plus its refresh token and optional
# Unix-millisecond expiry instead of username/password. An access token alone
# cannot be renewed after it expires in a long-running server.
# YAZIO_ACCESS_TOKEN=...
# YAZIO_REFRESH_TOKEN=...
# YAZIO_TOKEN_EXPIRES_AT=...

# Optional local mode. The Docker tunnel defaults to stdio; set MCP_TRANSPORT=http
# only when running the server directly as a Streamable HTTP endpoint.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# MCP_ALLOWED_ORIGINS=http://localhost:3000
